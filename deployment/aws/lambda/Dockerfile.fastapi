# =============================================================================
# SearchaaS — FastAPI on AWS Lambda (container image + Lambda Web Adapter)
#
# Strategy:
#   - Use the standard python:3.11-slim image (NOT the AWS base image), because
#     we have heavy native deps (pymongo, numpy, etc.) and we want the same
#     runtime as ECS for parity.
#   - AWS Lambda Web Adapter (LWA) is added as a layer at /opt/extensions and
#     proxies Lambda invocations to a local HTTP server (uvicorn on :8000).
#   - Lambda Function URL invokes this Lambda; LWA translates the URL request
#     into a normal HTTP request that FastAPI handles unchanged.
#
# Docs: https://github.com/awslabs/aws-lambda-web-adapter
# =============================================================================

# ---- Stage 1: builder ------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip \
 && pip install --prefix=/install --no-cache-dir --no-warn-script-location \
        -r requirements.txt

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.11-slim AS runtime

# 1) Pull the Lambda Web Adapter binary as a Lambda extension.
#    This single COPY is the magic that turns any HTTP server into a Lambda.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.0 \
     /lambda-adapter /opt/extensions/lambda-adapter

# 2) Carry installed Python packages from builder.
COPY --from=builder /install /usr/local

WORKDIR /var/task
COPY searchaas/ ./searchaas/

# ---- LWA configuration -----------------------------------------------------
# PORT             — port LWA forwards Lambda invokes to (uvicorn listens here)
# AWS_LWA_INVOKE_MODE
#                    buffered : standard request/response (FastAPI default; fine
#                               for sub-6 MB JSON bodies and <15 min timeouts)
#                    response_stream : enable for SSE / chunked responses
# AWS_LWA_READINESS_CHECK_PATH — LWA waits for 200 here before forwarding traffic
# AWS_LWA_ASYNC_INIT — start the app during INIT phase (saves cold-start latency
#                      that exceeds the 10s init budget)
ENV PORT=8000 \
    AWS_LWA_INVOKE_MODE=buffered \
    AWS_LWA_READINESS_CHECK_PATH=/health \
    AWS_LWA_ASYNC_INIT=true \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/var/task

EXPOSE 8000

# Lambda Function URL → LWA → uvicorn → FastAPI app at searchaas.api.app:app
CMD ["python", "-m", "uvicorn", "searchaas.api.app:app", \
     "--host", "0.0.0.0", "--port", "8000"]
