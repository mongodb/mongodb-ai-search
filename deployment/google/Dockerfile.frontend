# =============================================================================
# SearchaaS — React Frontend
# Serves the Vite/React SPA via nginx on port 8080 (Cloud Run default).
#
# Build (from repo root):
#   docker buildx build --platform linux/amd64 -f deployment/google/Dockerfile.frontend -t searchaas-frontend .
#
# Run locally (uses localhost backend defaults):
#   docker run -p 8080:8080 searchaas-frontend
#
# Run with custom backend URLs (e.g. after Cloud Run deploy):
#   docker run \
#     -e SEARCHAAS_API_URL=https://searchaas-api-xyz.run.app \
#     -e SEARCHAAS_MCP_URL=https://searchaas-mcp-xyz.run.app/mcp \
#     -p 8080:8080 searchaas-frontend
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — builder: compile the Vite/React app
# -----------------------------------------------------------------------------
FROM node:20-slim AS builder

WORKDIR /app

COPY searchaas/ui_react/package*.json ./
RUN npm ci --prefer-offline

COPY searchaas/ui_react/ ./
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2 — runtime: nginx serving static files + runtime config injection
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# SPA routing config
COPY deployment/google/nginx.conf /etc/nginx/conf.d/default.conf

# Built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Entrypoint script — writes /usr/share/nginx/html/config.js at container start
# using SEARCHAAS_API_URL and SEARCHAAS_MCP_URL environment variables.
COPY deployment/google/docker-entrypoint-frontend.sh /docker-entrypoint.d/40-inject-config.sh
RUN chmod +x /docker-entrypoint.d/40-inject-config.sh

# Cloud Run expects port 8080
EXPOSE 8080
