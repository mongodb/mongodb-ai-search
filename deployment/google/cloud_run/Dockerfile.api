# =============================================================================
# SearchaaS — FastAPI REST Server
# Exposes the REST API at http://0.0.0.0:8000
#
# Build (from repo root):
#   docker buildx build --platform linux/amd64 \
#       -f deployment/google/cloud_run/Dockerfile.api -t searchaas-api .
#
# Run:
#   docker run --env-file .env -p 8000:8000 searchaas-api
#
# With a custom config file:
#   docker run --env-file .env \
#              -v /path/to/searchaas.yaml:/app/searchaas/config/searchaas.yaml:ro \
#              -p 8000:8000 searchaas-api
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — builder: install Python dependencies into an isolated prefix
# -----------------------------------------------------------------------------
ARG BASE_REGISTRY=
FROM ${BASE_REGISTRY}python:3.11-slim AS builder

WORKDIR /build

# Build-time system packages (compilers for native extensions in pymongo, numpy, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies into /install so we can copy them cleanly to the runtime stage
COPY requirements.txt .
RUN pip install --upgrade pip \
 && pip install \
        --prefix=/install \
        --no-cache-dir \
        --no-warn-script-location \
        -r requirements.txt

# -----------------------------------------------------------------------------
# Stage 2 — runtime: minimal image with no build tools
# -----------------------------------------------------------------------------
ARG BASE_REGISTRY=
FROM ${BASE_REGISTRY}python:3.11-slim AS runtime

# Carry installed packages over from builder
COPY --from=builder /install /usr/local

WORKDIR /app

# Copy only the searchaas package (config yaml lives inside searchaas/config/)
COPY searchaas/ ./searchaas/

# ── Runtime environment ──────────────────────────────────────────────────────
# These are safe defaults. Override sensitive values at runtime via --env-file
# or individual -e flags — do NOT bake secrets into the image.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    SEARCHAAS_CONFIG=/app/searchaas/config/searchaas.yaml

# Cloud Run injects PORT at runtime (default 8000 for local runs).
# EXPOSE is documentation-only; the actual port is read from $PORT at startup.
ENV PORT=8000
EXPOSE 8000

# Non-root user for least-privilege execution
RUN useradd --no-create-home --shell /bin/false api
USER api

# Start the FastAPI server via uvicorn.
# $PORT is set by Cloud Run at container startup — uvicorn reads it via the
# shell entrypoint so the same image works locally (PORT=8000) and on Cloud Run
# (PORT=whatever Cloud Run assigns, typically 8080 or the --port flag value).
# Workers are kept at 1 to share the bootstrap singleton (get_container) cleanly.
# Scale horizontally with multiple containers rather than multiple workers.
CMD ["sh", "-c", \
     "exec uvicorn searchaas.api.app:app \
      --host 0.0.0.0 \
      --port ${PORT:-8000} \
      --workers 1 \
      --log-level info"]
