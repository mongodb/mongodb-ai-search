# ============================================================
# Employee Support Copilot — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# Base URL of the running SearchaaS instance.
# For local dev: http://localhost:8000
# For production: https://your-searchaas-host.example.com
SEARCHAAS_BASE_URL=http://localhost:8000

# Optional: API key if SearchaaS is protected by bearer auth.
# Leave blank for local dev without auth.
SEARCHAAS_API_KEY=
